{
  "app-id": "ad.yan.iceon",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "iceon",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=org.freedesktop.secrets"
  ],
  "modules": [
    {
      "name": "iceon",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --frozen --offline --release -p iceon-app",
        "install -Dm755 target/release/iceon /app/bin/iceon",
        "install -Dm644 packaging/linux/ad.yan.iceon.desktop /app/share/applications/ad.yan.iceon.desktop",
        "install -Dm644 packaging/linux/ad.yan.iceon.metainfo.xml /app/share/metainfo/ad.yan.iceon.metainfo.xml",
        "install -Dm644 assets/icons/icon.png /app/share/icons/hicolor/1024x1024/apps/ad.yan.iceon.png"
      ],
      "sources": [{"type": "dir", "path": "source"}]
    }
  ]
}
